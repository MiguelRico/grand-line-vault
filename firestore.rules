rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validFreeProfile(uid) {
      return request.resource.data.keys().hasAll([
          'schemaVersion', 'uid', 'email', 'displayName', 'premium',
          'cloudSync', 'adsEnabled', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'uid', 'email', 'displayName', 'premium',
          'cloudSync', 'adsEnabled', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.premium == false
        && request.resource.data.cloudSync == false
        && request.resource.data.adsEnabled == true
        && request.resource.data.email is string
        && (request.resource.data.displayName == null
          || request.resource.data.displayName is string)
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
    }

    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && validFreeProfile(uid);
      allow update: if false;
      allow list, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
